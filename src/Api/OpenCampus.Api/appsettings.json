{
  "ConnectionStrings": {
    "OpenCampus": ""
  },
  "DataProtection": {
    "KeyDirectory": "keys/data-protection"
  },
  "Tokens": {
    "Issuer": "OpenCampus",
    "Audience": "OpenCampus.Client",
    "AccessTokenLifetime": "00:15:00",
    "RefreshTokenLifetime": "14.00:00:00",
    "SigningKeyPath": "keys/token-signing.pem"
  },
  "AccountProtection": {
    "LockoutThreshold": 5,
    "LockoutDuration": "00:15:00",
    "RateLimitWindow": "00:01:00",
    "RateLimitPermittedRequests": 10
  },
  "PasswordHashing": {
    "Iterations": 600000
  },
  "Academic": {
    "PassThresholdPercent": 50,
    "AttendanceThresholdPercent": 75
  },
  "Notification": {
    "Implementation": "Local",
    "OutputPath": "data/notifications",
    "SenderIdentity": "OpenCampus <no-reply@opencampus.local>"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Storage": {
    "RootPath": "data/files",
    "MaxUploadSizeBytes": 26214400,
    "PermittedExtensions": [ ".pdf", ".docx", ".pptx", ".xlsx", ".txt", ".md", ".png", ".jpg", ".jpeg", ".zip", ".mp4" ]
  },
  "Provisioning": {
    "ReferenceDataEnabled": true,
    "DemonstrationDataEnabled": false,
    "AdministratorUserName": "admin",
    "AdministratorEmail": "admin@opencampus.local",
    "CredentialsFilePath": "data/provisioning/credentials.txt"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/opencampus-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{CorrelationId}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
